@model JwtAuthApp.Models.MonitoringPost

@{
    ViewData["Title"] = "Детали поста";
}

<h2>Детали поста мониторинга</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Название</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Описание</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "Нет описания" : Model.Description)</dd>

            <dt class="col-sm-3">Адрес</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Address) ? "Не указан" : Model.Address)</dd>

            <dt class="col-sm-3">Координаты</dt>
            <dd class="col-sm-9">
                @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                {
                    <span>Широта: @Model.Latitude°, Долгота: @Model.Longitude°</span>
                }
                else
                {
                    <span class="text-muted">Не заданы</span>
                }
            </dd>

            <dt class="col-sm-3">Мобильный</dt>
            <dd class="col-sm-9">
                @if (Model.IsMobile)
                {
                    <span class="badge bg-info">Мобильный пост</span>
                }
                else
                {
                    <span class="badge bg-secondary">Стационарный пост</span>
                }
            </dd>

            <dt class="col-sm-3">Статус</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Активен</span>
                }
                else
                {
                    <span class="badge bg-danger">Неактивен</span>
                }
            </dd>

            <dt class="col-sm-3">Интервал опроса</dt>
            <dd class="col-sm-9">@Model.PollingIntervalSeconds сек.</dd>

            <dt class="col-sm-3">Последний опрос</dt>
            <dd class="col-sm-9">@(Model.LastPolledAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</dd>

            <dt class="col-sm-3">Создан</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</dd>

            <dt class="col-sm-3">Обновлён</dt>
            <dd class="col-sm-9">@Model.UpdatedAt.ToString("dd.MM.yyyy HH:mm:ss")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редактировать</a>
        <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
    </div>
</div>
