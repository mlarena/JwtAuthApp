@model JwtAuthApp.Models.MonitoringPost

@{
    ViewData["Title"] = "Удаление поста";
}

<h2>Удаление поста</h2>

<div class="alert alert-danger">
    <h4>Вы уверены, что хотите удалить этот пост?</h4>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Название</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Описание</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "Нет описания" : Model.Description)</dd>

            <dt class="col-sm-3">Координаты</dt>
            <dd class="col-sm-9">
                @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                {
                    <span>@Model.Latitude°, @Model.Longitude°</span>
                }
                else
                {
                    <span class="text-muted">Нет координат</span>
                }
            </dd>

            <dt class="col-sm-3">Мобильный</dt>
            <dd class="col-sm-9">@(Model.IsMobile ? "Да" : "Нет")</dd>

            <dt class="col-sm-3">Активен</dt>
            <dd class="col-sm-9">@(Model.IsActive ? "Да" : "Нет")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>
