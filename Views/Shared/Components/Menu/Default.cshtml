@model IEnumerable<JwtAuthApp.ViewComponents.MenuItemViewModel>

@foreach (var item in Model)
{
    @if (item.IsDropdown)
    {
        <li class="sidebar-item">
            <button class="sidebar-toggle-btn" type="button" data-bs-toggle="collapse" data-bs-target="#submenu-@item.Text.Replace(" ", "")" aria-expanded="false">
                <i class="bi @item.Icon"></i>
                <span>@item.Text</span>
                <i class="bi bi-chevron-right chevron"></i>
            </button>
            <ul class="submenu collapse list-unstyled" id="submenu-@item.Text.Replace(" ", "")">
                @foreach (var child in item.Children)
                {
                    <li class="sidebar-item">
                        <a class="sidebar-link" asp-controller="@child.Controller" asp-action="@child.Action">
                            <i class="bi @child.Icon"></i>
                            <span class="link-text">@child.Text</span>
                        </a>
                    </li>
                }
            </ul>
        </li>
    }
    else
    {
        <li class="sidebar-item">
            <a class="sidebar-link" asp-controller="@item.Controller" asp-action="@item.Action">
                <i class="bi @item.Icon"></i>
                <span class="link-text">@item.Text</span>
            </a>
        </li>
    }
}
