<!DOCTYPE html>
<html lang="ru" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JwtAuthApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- TOP BAR -->
        <div class="topbar">
            <button class="topbar-toggle" id="sidebarToggle" title="Меню">
                <i class="bi bi-list"></i>
            </button>
            <a class="topbar-brand" asp-controller="Home" asp-action="Index">JwtAuthApp</a>
            <div class="topbar-spacer"></div>
            <div class="topbar-user">
                <div class="avatar">@User.Identity!.Name![0].ToString().ToUpper()</div>
                <span>@User.Identity.Name</span>
            </div>
            <button class="theme-toggle" id="themeToggle" title="Переключить тему">
                <i class="bi bi-moon-fill"></i>
            </button>
            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="topbar-btn" title="Выход">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </form>
        </div>

        <!-- SIDEBAR -->
        <nav class="sidebar" id="sidebar">
            <ul class="sidebar-menu">
                @await Component.InvokeAsync("Menu")
            </ul>
        </nav>

        <!-- OVERLAY для мобильных -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- MAIN CONTENT -->
        <div class="main-content-wrapper">
            <div class="main-content">
                @RenderBody()
            </div>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var sidebar = document.getElementById('sidebar');
                var toggle = document.getElementById('sidebarToggle');
                var overlay = document.getElementById('sidebarOverlay');
                var themeToggle = document.getElementById('themeToggle');
                var html = document.documentElement;

                // Восстановление темы
                var savedTheme = localStorage.getItem('theme') || 'light';
                applyTheme(savedTheme);

                // Sidebar toggle
                if (toggle && sidebar) {
                    toggle.addEventListener('click', function () {
                        if (window.innerWidth <= 768) {
                            sidebar.classList.toggle('show');
                        } else {
                            sidebar.classList.toggle('collapsed');
                            localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
                        }
                    });
                }

                // Overlay — закрытие sidebar на мобильных
                if (overlay && sidebar) {
                    overlay.addEventListener('click', function () {
                        sidebar.classList.remove('show');
                    });
                }

                // Восстановление состояния sidebar
                if (sidebar && localStorage.getItem('sidebarCollapsed') === 'true' && window.innerWidth > 768) {
                    sidebar.classList.add('collapsed');
                }

                // Theme toggle
                if (themeToggle) {
                    themeToggle.addEventListener('click', function () {
                        var current = html.getAttribute('data-theme');
                        applyTheme(current === 'dark' ? 'light' : 'dark');
                    });
                }

                function applyTheme(theme) {
                    html.setAttribute('data-theme', theme);
                    localStorage.setItem('theme', theme);
                    if (themeToggle) {
                        var icon = themeToggle.querySelector('i');
                        if (icon) {
                            icon.className = theme === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
                        }
                    }
                }

                // Подсветка активного пункта меню
                document.querySelectorAll('.sidebar-link').forEach(function (link) {
                    var href = link.getAttribute('href');
                    if (href && window.location.pathname.toLowerCase().startsWith(href.toLowerCase())) {
                        link.classList.add('active');
                    }
                });
            });
        </script>
    }
    else
    {
        <main>
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
