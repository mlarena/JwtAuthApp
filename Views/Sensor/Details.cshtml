@model JwtAuthApp.Models.Sensor

@{
    ViewData["Title"] = "Детали датчика";
}

<h2>Детали датчика</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Серийный номер</dt>
            <dd class="col-sm-9">@Model.SerialNumber</dd>

            <dt class="col-sm-3">Имя EndPoint</dt>
            <dd class="col-sm-9">@Model.EndPointsName</dd>

            <dt class="col-sm-3">URL</dt>
            <dd class="col-sm-9"><code>@Model.Url</code></dd>

            <dt class="col-sm-3">Тип датчика</dt>
            <dd class="col-sm-9">@(Model.SensorType?.SensorTypeName ?? "—")</dd>

            <dt class="col-sm-3">Пост мониторинга</dt>
            <dd class="col-sm-9">@(Model.MonitoringPost?.Name ?? "Не привязан")</dd>

            <dt class="col-sm-3">Координаты</dt>
            <dd class="col-sm-9">
                @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                {
                    <span>Широта: @Model.Latitude°, Долгота: @Model.Longitude°</span>
                }
                else
                {
                    <span class="text-muted">Не заданы</span>
                }
            </dd>

            <dt class="col-sm-3">Статус</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Активен</span>
                }
                else
                {
                    <span class="badge bg-danger">Неактивен</span>
                }
            </dd>

            <dt class="col-sm-3">Последняя активность</dt>
            <dd class="col-sm-9">@(Model.LastActivityUTC?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</dd>

            <dt class="col-sm-3">Создан</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редактировать</a>
        <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
    </div>
</div>
