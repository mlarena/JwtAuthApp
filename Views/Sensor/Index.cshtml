@model IEnumerable<JwtAuthApp.Models.Sensor>

@{
    ViewData["Title"] = "Датчики";
}

<h2>Датчики</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Создать датчик</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Название</th>
            <th>Тип</th>
            <th>Ед. измерения</th>
            <th>Диапазон</th>
            <th>Статус</th>
            <th>Создан</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.IsActive ? "" : "table-secondary")">
                <td>@item.Name</td>
                <td>@(item.Type ?? "-")</td>
                <td>@(item.Unit ?? "-")</td>
                <td>
                    @if (item.MinValue.HasValue && item.MaxValue.HasValue)
                    {
                        <span>@item.MinValue — @item.MaxValue</span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Активен</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Неактивен</span>
                    }
                </td>
                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Подробнее</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редактировать</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-secondary" : "btn-success")">
                                @(item.IsActive ? "Деактивировать" : "Активировать")
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
