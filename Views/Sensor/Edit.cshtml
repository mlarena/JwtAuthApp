@model JwtAuthApp.Models.Sensor

@{
    ViewData["Title"] = "Редактирование датчика";
}

<h2>Редактирование датчика</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="LastActivityUTC" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="SerialNumber" class="control-label">Серийный номер</label>
                <input asp-for="SerialNumber" class="form-control" />
                <span asp-validation-for="SerialNumber" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EndPointsName" class="control-label">Имя EndPoint</label>
                <input asp-for="EndPointsName" class="form-control" />
                <span asp-validation-for="EndPointsName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Url" class="control-label">URL</label>
                <input asp-for="Url" class="form-control" />
                <span asp-validation-for="Url" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SensorTypeId" class="control-label">Тип датчика</label>
                <select asp-for="SensorTypeId" class="form-select">
                    <option value="">-- Выберите тип --</option>
                    @foreach (var st in (ViewBag.SensorTypes as IEnumerable<JwtAuthApp.Models.SensorType>) ?? Enumerable.Empty<JwtAuthApp.Models.SensorType>())
                    {
                        <option value="@st.Id">@st.SensorTypeName</option>
                    }
                </select>
                <span asp-validation-for="SensorTypeId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MonitoringPostId" class="control-label">Пост мониторинга</label>
                <select asp-for="MonitoringPostId" class="form-select">
                    <option value="">-- Не привязан --</option>
                    @foreach (var mp in (ViewBag.MonitoringPosts as IEnumerable<JwtAuthApp.Models.MonitoringPost>) ?? Enumerable.Empty<JwtAuthApp.Models.MonitoringPost>())
                    {
                        <option value="@mp.Id">@mp.Name</option>
                    }
                </select>
                <span asp-validation-for="MonitoringPostId" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Latitude" class="control-label">Широта</label>
                        <input asp-for="Latitude" class="form-control" type="number" step="any" />
                        <span asp-validation-for="Latitude" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Longitude" class="control-label">Долгота</label>
                        <input asp-for="Longitude" class="form-control" type="number" step="any" />
                        <span asp-validation-for="Longitude" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Активен</label>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
