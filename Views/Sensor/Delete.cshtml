@model JwtAuthApp.Models.Sensor

@{
    ViewData["Title"] = "Delete Sensor";
}

<h2>Delete Sensor</h2>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this sensor?</h4>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@(Model.Type ?? "-")</dd>

            <dt class="col-sm-3">Unit</dt>
            <dd class="col-sm-9">@(Model.Unit ?? "-")</dd>

            <dt class="col-sm-3">Range</dt>
            <dd class="col-sm-9">
                @if (Model.MinValue.HasValue && Model.MaxValue.HasValue)
                {
                    <span>@Model.MinValue — @Model.MaxValue</span>
                }
                else
                {
                    <span class="text-muted">-</span>
                }
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
