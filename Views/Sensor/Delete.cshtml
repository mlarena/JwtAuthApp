@model JwtAuthApp.Models.Sensor

@{
    ViewData["Title"] = "Удаление датчика";
}

<h2>Удаление датчика</h2>

<div class="alert alert-danger">
    <h4>Вы уверены, что хотите удалить этот датчик?</h4>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Серийный номер</dt>
            <dd class="col-sm-9">@Model.SerialNumber</dd>

            <dt class="col-sm-3">Имя EndPoint</dt>
            <dd class="col-sm-9">@Model.EndPointsName</dd>

            <dt class="col-sm-3">URL</dt>
            <dd class="col-sm-9"><code>@Model.Url</code></dd>

            <dt class="col-sm-3">Тип датчика</dt>
            <dd class="col-sm-9">@(Model.SensorType?.SensorTypeName ?? "—")</dd>

            <dt class="col-sm-3">Пост мониторинга</dt>
            <dd class="col-sm-9">@(Model.MonitoringPost?.Name ?? "—")</dd>

            <dt class="col-sm-3">Статус</dt>
            <dd class="col-sm-9">@(Model.IsActive ? "Активен" : "Неактивен")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>
