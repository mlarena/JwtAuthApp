@model JwtAuthApp.Models.Sensor

@{
    ViewData["Title"] = "Удалить датчик";
}

<h2>Удалить датчик</h2>

<div class="alert alert-danger">
    <h4>Вы уверены, что хотите удалить этот датчик?</h4>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Название</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Тип</dt>
            <dd class="col-sm-9">@(Model.Type ?? "-")</dd>

            <dt class="col-sm-3">Ед. измерения</dt>
            <dd class="col-sm-9">@(Model.Unit ?? "-")</dd>

            <dt class="col-sm-3">Диапазон</dt>
            <dd class="col-sm-9">
                @if (Model.MinValue.HasValue && Model.MaxValue.HasValue)
                {
                    <span>@Model.MinValue — @Model.MaxValue</span>
                }
                else
                {
                    <span class="text-muted">-</span>
                }
            </dd>

            <dt class="col-sm-3">Статус</dt>
            <dd class="col-sm-9">@(Model.IsActive ? "Активен" : "Неактивен")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>
