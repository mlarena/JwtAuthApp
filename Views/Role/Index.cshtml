@model IEnumerable<JwtAuthApp.Models.Role>

@{
    ViewData["Title"] = "Роли";
}

<h2>Управление ролями</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Создать роль</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Название</th>
            <th>Описание</th>
            <th>Пользователей</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@item.Name</strong></td>
                <td>@(item.Description ?? "—")</td>
                <td><span class="badge bg-secondary">@item.UserRoles.Count чел.</span></td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редактировать</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">Роли не найдены. Нажмите «Создать роль» для добавления.</div>
}
