@model IEnumerable<JwtAuthApp.Models.DataIWS>

@{
    ViewData["Title"] = "Данные IWS";
}

<h2>Данные IWS</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Create" class="btn btn-primary">Создать запись</a>
    </div>
    <div>
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <select name="sensorId" class="form-select" style="width: auto;">
                <option value="">Все датчики</option>
                @foreach (var sensor in (ViewBag.Sensors as IEnumerable<JwtAuthApp.Models.Sensor>) ?? Enumerable.Empty<JwtAuthApp.Models.Sensor>())
                {
                    <option value="@sensor.Id" selected="@(ViewBag.SelectedSensorId?.ToString() == sensor.Id.ToString())">@sensor.Name</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-secondary">Фильтр</button>
        </form>
    </div>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Датчик</th>
            <th>Значение</th>
            <th>Дата записи</th>
            <th>Создан</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.Sensor?.Name ?? $"Датчик #{item.SensorId}")</td>
                <td>@item.Value</td>
                <td>@item.RecordedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Подробнее</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редактировать</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
