@model JwtAuthApp.Models.DataIWS

@{
    ViewData["Title"] = "Удалить запись";
}

<h2>Удалить запись</h2>

<div class="alert alert-danger">
    <h4>Вы уверены, что хотите удалить эту запись?</h4>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Датчик</dt>
            <dd class="col-sm-9">@(Model.Sensor?.Name ?? $"Датчик #{Model.SensorId}")</dd>

            <dt class="col-sm-3">Значение</dt>
            <dd class="col-sm-9">@Model.Value</dd>

            <dt class="col-sm-3">Дата записи</dt>
            <dd class="col-sm-9">@Model.RecordedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>

            <dt class="col-sm-3">Создан</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>
