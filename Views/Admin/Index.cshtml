@model IEnumerable<JwtAuthApp.Models.User>

@{
    ViewData["Title"] = "User Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-people"></i> User Management</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-person-plus"></i> Create New User
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Roles</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.UserName</td>
                            <td>
                                @if (user.UserRoles.Any())
                                {
                                    @foreach (var ur in user.UserRoles)
                                    {
                                        <span class="badge bg-info me-1">@ur.Role.Name</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No roles</span>
                                }
                            </td>
                            <td>@user.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ManageRoles" asp-route-id="@user.Id" class="btn btn-sm btn-success" title="Manage Roles">
                                        <i class="bi bi-shield-lock"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@user.Id" method="post"
                                          style="display:inline;"
                                          onsubmit="return confirm('Are you sure you want to delete @user.UserName?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center">
                    No users found. Click "Create New User" to add one.
                </div>
            }
        </div>
    </div>
</div>
