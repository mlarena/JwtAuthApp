@model IEnumerable<JwtAuthApp.Models.User>

@{
    ViewData["Title"] = "Управление пользователями";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-people"></i> Управление пользователями</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-person-plus"></i> Создать пользователя
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:60px">ID</th>
                        <th>Пользователь</th>
                        <th>Статус</th>
                        <th>Роли</th>
                        <th style="width:160px">Создан</th>
                        <th style="width:320px">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr class="@(user.IsBlocked ? "table-danger" : "")">
                            <td class="text-muted">@user.Id</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle @(user.IsBlocked ? "bg-danger" : "bg-primary") text-white d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;font-size:0.8rem;">
                                        @user.UserName[0].ToString().ToUpper()
                                    </div>
                                    <div>
                                        <strong class="@(user.IsBlocked ? "text-decoration-line-through text-muted" : "")">@user.UserName</strong>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (user.IsBlocked)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-lock-fill"></i> Заблокирован</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="bi bi-unlock"></i> Активен</span>
                                }
                            </td>
                            <td>
                                @if (user.UserRoles.Any())
                                {
                                    @foreach (var ur in user.UserRoles)
                                    {
                                        <span class="badge bg-info me-1 d-inline-flex align-items-center">
                                            @ur.Role.Name
                                            <form asp-action="QuickRemoveRole" method="post" class="d-inline ms-1" style="display:inline!important;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <input type="hidden" name="roleName" value="@ur.Role.Name" />
                                                <button type="submit" class="btn btn-sm p-0 border-0 bg-transparent text-white" title="Удалить роль" style="line-height:1;font-size:0.7rem;">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </form>
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Нет ролей</span>
                                }
                            </td>
                            <td class="text-muted">@user.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Редактировать">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ChangePassword" asp-route-id="@user.Id" class="btn btn-outline-warning" title="Сменить пароль">
                                        <i class="bi bi-key"></i>
                                    </a>
                                    <a asp-action="ManageRoles" asp-route-id="@user.Id" class="btn btn-outline-success" title="Управление ролями">
                                        <i class="bi bi-shield-lock"></i>
                                    </a>
                                    <form asp-action="ToggleBlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(user.IsBlocked ? "btn-outline-success" : "btn-outline-warning")" title="@(user.IsBlocked ? "Разблокировать" : "Заблокировать")">
                                            <i class="bi @(user.IsBlocked ? "bi-unlock" : "bi-lock")"></i>
                                        </button>
                                    </form>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Быстро добавить роль">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            @foreach (var role in GetAllRoles(user))
                                            {
                                                <li>
                                                    <form asp-action="QuickAddRole" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@user.Id" />
                                                        <input type="hidden" name="roleName" value="@role" />
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="bi bi-plus-circle text-success me-1"></i> @role
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                    <form asp-action="Delete" asp-route-id="@user.Id" method="post"
                                          style="display:inline;"
                                          onsubmit="return confirm('Удалить пользователя @user.UserName?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Удалить">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center m-3">
                    Пользователи не найдены. Нажмите «Создать пользователя» для добавления.
                </div>
            }
        </div>
    </div>
</div>

@functions {
    IEnumerable<string> GetAllRoles(JwtAuthApp.Models.User user)
    {
        var assignedRoleIds = user.UserRoles.Select(ur => ur.RoleId).ToList();
        var allRoles = ViewBag.AllRoles as IEnumerable<JwtAuthApp.Models.Role> ?? Enumerable.Empty<JwtAuthApp.Models.Role>();
        return allRoles.Where(r => !assignedRoleIds.Contains(r.Id)).Select(r => r.Name);
    }
}
