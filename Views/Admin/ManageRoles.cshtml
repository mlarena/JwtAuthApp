@model JwtAuthApp.ViewModels.ManageUserRolesViewModel

@{
    ViewData["Title"] = $"Roles — {Model.UserName}";
}

<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- User info card -->
    <div class="card mb-4">
        <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:56px;height:56px;font-size:1.5rem;">
                @Model.UserName[0].ToString().ToUpper()
            </div>
            <div>
                <h4 class="mb-0">@Model.UserName</h4>
                <span class="text-muted">User ID: @Model.UserId</span>
            </div>
            <div class="ms-auto">
                @{
                    var selectedCount = Model.AllRoles.Count(r => r.IsSelected);
                }
                <span class="badge bg-success fs-6">@selectedCount role@(selectedCount != 1 ? "s" : "") assigned</span>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left column: Assigned roles -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-success text-white d-flex align-items-center">
                    <i class="bi bi-shield-check me-2"></i>
                    <h5 class="mb-0">Assigned Roles</h5>
                </div>
                <div class="card-body">
                    @{
                        var assignedRoles = Model.AllRoles.Where(r => r.IsSelected).ToList();
                        var availableRoles = Model.AllRoles.Where(r => !r.IsSelected).ToList();
                    }

                    @if (assignedRoles.Any())
                    {
                        @for (int i = 0; i < Model.AllRoles.Count; i++)
                        {
                            @if (Model.AllRoles[i].IsSelected)
                            {
                                <input type="hidden" asp-for="AllRoles[i].RoleId" />
                                <input type="hidden" asp-for="AllRoles[i].RoleName" />
                                <input type="hidden" asp-for="AllRoles[i].IsSelected" />
                            }
                        }

                        <div class="list-group list-group-flush">
                            @for (int i = 0; i < Model.AllRoles.Count; i++)
                            {
                                @if (Model.AllRoles[i].IsSelected)
                                {
                                    <div class="list-group-item d-flex align-items-center justify-content-between py-3">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-shield-fill text-success me-3 fs-5"></i>
                                            <div>
                                                <strong>@Model.AllRoles[i].RoleName</strong>
                                            </div>
                                        </div>
                                        <span class="badge bg-success">Active</span>
                                    </div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-shield-x fs-1 d-block mb-2"></i>
                            <p class="mb-0">No roles assigned yet</p>
                            <small>Select a role from the right panel</small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right column: Available roles -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-primary text-white d-flex align-items-center">
                    <i class="bi bi-plus-shield me-2"></i>
                    <h5 class="mb-0">Available Roles</h5>
                </div>
                <div class="card-body">
                    @if (availableRoles.Any())
                    {
                        <div class="list-group list-group-flush">
                            @for (int i = 0; i < Model.AllRoles.Count; i++)
                            {
                                @if (!Model.AllRoles[i].IsSelected)
                                {
                                    <input type="hidden" asp-for="AllRoles[i].RoleId" />
                                    <input type="hidden" asp-for="AllRoles[i].RoleName" />
                                    <input type="hidden" asp-for="AllRoles[i].IsSelected" value="false" />

                                    <div class="list-group-item d-flex align-items-center justify-content-between py-3">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-shield text-muted me-3 fs-5"></i>
                                            <div>
                                                <strong>@Model.AllRoles[i].RoleName</strong>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-success add-role-btn"
                                                data-index="@i"
                                                onclick="toggleRole(this, @i, true)">
                                            <i class="bi bi-plus-lg"></i> Add
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-check-circle fs-1 d-block mb-2"></i>
                            <p class="mb-0">All roles are already assigned</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Action buttons -->
    <form asp-action="ManageRoles" method="post" id="rolesForm">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="UserName" />

        @for (int i = 0; i < Model.AllRoles.Count; i++)
        {
            <input type="hidden" asp-for="AllRoles[i].RoleId" />
            <input type="hidden" asp-for="AllRoles[i].RoleName" />
            <input type="hidden" asp-for="AllRoles[i].IsSelected" id="role_@i" />
        }

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-arrow-left"></i> Back to Users
            </a>
            <button type="submit" class="btn btn-primary btn-lg" id="saveBtn">
                <i class="bi bi-check-lg"></i> Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function toggleRole(btn, index, isAdding) {
            var hiddenInput = document.getElementById('role_' + index);
            hiddenInput.value = isAdding ? 'true' : 'false';

            // Visually move the item
            var item = btn.closest('.list-group-item');
            var targetContainer;

            if (isAdding) {
                // Move to assigned column (left)
                targetContainer = document.querySelector('.col-md-6:first-child .list-group');
                if (!targetContainer || targetContainer.querySelector('.text-center')) {
                    // Replace empty state with list
                    var leftCard = document.querySelector('.col-md-6:first-child .card-body');
                    leftCard.innerHTML = '<div class="list-group list-group-flush assigned-list"></div>';
                    targetContainer = leftCard.querySelector('.list-group');
                }

                // Update icon
                var icon = item.querySelector('i');
                icon.className = 'bi bi-shield-fill text-success me-3 fs-5';

                // Update button
                btn.className = 'btn btn-sm btn-outline-danger remove-role-btn';
                btn.innerHTML = '<i class="bi bi-dash-lg"></i> Remove';
                btn.setAttribute('onclick', 'toggleRole(this, ' + index + ', false)');

                // Add badge
                var badge = document.createElement('span');
                badge.className = 'badge bg-success';
                badge.textContent = 'Active';
                item.appendChild(badge);

                targetContainer.appendChild(item);
            } else {
                // Move to available column (right)
                targetContainer = document.querySelector('.col-md-6:last-of-type .list-group');
                if (!targetContainer) {
                    var rightCard = document.querySelector('.col-md-6:last-of-type .card-body');
                    rightCard.innerHTML = '<div class="list-group list-group-flush available-list"></div>';
                    targetContainer = rightCard.querySelector('.list-group');
                }

                // Update icon
                var icon = item.querySelector('i');
                icon.className = 'bi bi-shield text-muted me-3 fs-5';

                // Update button
                btn.className = 'btn btn-sm btn-outline-success add-role-btn';
                btn.innerHTML = '<i class="bi bi-plus-lg"></i> Add';
                btn.setAttribute('onclick', 'toggleRole(this, ' + index + ', true)');

                // Remove badge
                var badge = item.querySelector('.badge');
                if (badge) badge.remove();

                targetContainer.appendChild(item);
            }

            updateEmptyStates();
        }

        function updateEmptyStates() {
            var leftList = document.querySelector('.col-md-6:first-child .list-group');
            var rightList = document.querySelector('.col-md-6:last-of-type .list-group');

            var leftItems = leftList ? leftList.querySelectorAll('.list-group-item').length : 0;
            var rightItems = rightList ? rightList.querySelectorAll('.list-group-item').length : 0;

            // Update left empty state
            var leftEmpty = document.querySelector('.col-md-6:first-child .text-center');
            if (leftItems === 0 && !leftEmpty) {
                var leftBody = document.querySelector('.col-md-6:first-child .card-body');
                leftBody.innerHTML = '<div class="text-center py-4 text-muted"><i class="bi bi-shield-x fs-1 d-block mb-2"></i><p class="mb-0">No roles assigned yet</p><small>Select a role from the right panel</small></div>';
            } else if (leftItems > 0 && leftEmpty) {
                leftEmpty.remove();
            }

            // Update right empty state
            var rightEmpty = document.querySelector('.col-md-6:last-of-type .text-center');
            if (rightItems === 0 && !rightEmpty) {
                var rightBody = document.querySelector('.col-md-6:last-of-type .card-body');
                rightBody.innerHTML = '<div class="text-center py-4 text-muted"><i class="bi bi-check-circle fs-1 d-block mb-2"></i><p class="mb-0">All roles are already assigned</p></div>';
            } else if (rightItems > 0 && rightEmpty) {
                rightEmpty.remove();
            }
        }
    </script>
}
