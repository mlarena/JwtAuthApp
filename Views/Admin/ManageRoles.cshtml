@model JwtAuthApp.ViewModels.ManageUserRolesViewModel

@{
    ViewData["Title"] = $"Manage Roles - {Model.UserName}";
}

<h2>Manage Roles for @Model.UserName</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="ManageRoles" method="post">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="UserName" />

            <div class="card">
                <div class="card-header">
                    <h5>Select roles for this user</h5>
                </div>
                <div class="card-body">
                    @for (int i = 0; i < Model.AllRoles.Count; i++)
                    {
                        <input type="hidden" asp-for="AllRoles[i].RoleId" />
                        <input type="hidden" asp-for="AllRoles[i].RoleName" />
                        <div class="form-check mb-2">
                            <input asp-for="AllRoles[i].IsSelected" class="form-check-input" />
                            <label class="form-check-label" for="AllRoles_@(i)__IsSelected">
                                <strong>@Model.AllRoles[i].RoleName</strong>
                            </label>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Save Roles</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>
