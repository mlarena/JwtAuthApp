@model IEnumerable<JwtAuthApp.Models.PollingSession>

@{
    ViewData["Title"] = "Сессии опроса";
}

<h2>Сессии опроса</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>Пост</th>
            <th>Начало</th>
            <th>Завершение</th>
            <th>Статус</th>
            <th>Всего датчиков</th>
            <th>Успешных</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><code>@item.Id.ToString().Substring(0, 8)...</code></td>
                <td>@(item.MonitoringPost?.Name ?? "—")</td>
                <td>@item.StartedAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                <td>@(item.CompletedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</td>
                <td>
                    @if (item.Status == "COMPLETED")
                    {
                        <span class="badge bg-success">Завершена</span>
                    }
                    else if (item.Status == "IN_PROGRESS")
                    {
                        <span class="badge bg-warning">В процессе</span>
                    }
                    else if (item.Status == "FAILED")
                    {
                        <span class="badge bg-danger">Ошибка</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@item.Status</span>
                    }
                </td>
                <td>@item.TotalSensorsCount</td>
                <td>@item.SuccessfulSensorsCount</td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Подробнее</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
