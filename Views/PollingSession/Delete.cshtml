@model JwtAuthApp.Models.PollingSession

@{
    ViewData["Title"] = "Удаление сессии опроса";
}

<h2>Удаление сессии опроса</h2>

<div class="alert alert-danger">
    <h4>Вы уверены, что хотите удалить эту сессию опроса?</h4>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9"><code>@Model.Id</code></dd>

            <dt class="col-sm-3">Пост мониторинга</dt>
            <dd class="col-sm-9">@(Model.MonitoringPost?.Name ?? "—")</dd>

            <dt class="col-sm-3">Начало</dt>
            <dd class="col-sm-9">@Model.StartedAt.ToString("dd.MM.yyyy HH:mm:ss")</dd>

            <dt class="col-sm-3">Статус</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>
