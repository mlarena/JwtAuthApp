@model IEnumerable<JwtAuthApp.Models.ControllerAccess>

@{
    ViewData["Title"] = "Управление доступом";
    var allRoles = ViewBag.AllRoles as IEnumerable<JwtAuthApp.Models.Role> ?? Enumerable.Empty<JwtAuthApp.Models.Role>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-key"></i> Управление доступом</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i>
        Настройте, какие роли могут обращаться к каждому контроллеру. <strong>Все авторизованные</strong> — доступно всем вошедшим в систему.
        Если выбраны конкретные роли — доступ будут иметь только пользователи с этими ролями.
    </div>

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Контроллер</th>
                        <th>Отображаемое имя</th>
                        <th>Режим доступа</th>
                        <th>Разрешённые роли</th>
                        <th style="width:180px">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><code>@item.ControllerName</code></td>
                            <td><strong>@item.DisplayName</strong></td>
                            <td>
                                @if (item.AllowAllAuthenticated)
                                {
                                    <span class="badge bg-success">Все авторизованные</span>
                                }
                                else if (item.ControllerAccessRoles.Any())
                                {
                                    <span class="badge bg-warning text-dark">Ограничено ролями</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Без правил</span>
                                }
                            </td>
                            <td>
                                @if (item.AllowAllAuthenticated)
                                {
                                    <span class="text-muted">Все пользователи</span>
                                }
                                else if (item.ControllerAccessRoles.Any())
                                {
                                    @foreach (var cr in item.ControllerAccessRoles)
                                    {
                                        <span class="badge bg-info me-1 d-inline-flex align-items-center">
                                            @cr.Role.Name
                                            <form asp-action="QuickToggle" method="post" class="d-inline ms-1" style="display:inline!important;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="roleName" value="@cr.Role.Name" />
                                                <input type="hidden" name="addRole" value="false" />
                                                <button type="submit" class="btn btn-sm p-0 border-0 bg-transparent text-white" title="Удалить" style="line-height:1;font-size:0.7rem;">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </form>
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Редактировать">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-success dropdown-toggle" data-bs-toggle="dropdown" title="Добавить роль">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            @foreach (var role in allRoles.Where(r => !item.ControllerAccessRoles.Any(cr => cr.RoleId == r.Id)))
                                            {
                                                <li>
                                                    <form asp-action="QuickToggle" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="roleName" value="@role.Name" />
                                                        <input type="hidden" name="addRole" value="true" />
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="bi bi-plus-circle text-success me-1"></i> @role.Name
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                    <form asp-action="ToggleAllowAll" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm @(item.AllowAllAuthenticated ? "btn-success" : "btn-outline-secondary")" title="Переключить доступ для всех">
                                            <i class="bi bi-globe"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
