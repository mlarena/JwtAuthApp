@model JwtAuthApp.ViewModels.ControllerAccessEditViewModel

@{
    ViewData["Title"] = $"Редактирование доступа — {Model.DisplayName}";
}

<div class="container mt-4">
    <h2><i class="bi bi-key"></i> Редактирование доступа: @Model.DisplayName</h2>

    <div class="row mt-4">
        <div class="col-md-8">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ControllerName" />

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Настройки контроллера</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Имя контроллера</label>
                            <input class="form-control" value="@Model.ControllerName" disabled />
                        </div>
                        <div class="mb-3">
                            <label asp-for="DisplayName" class="form-label fw-bold">Отображаемое имя</label>
                            <input asp-for="DisplayName" class="form-control" />
                            <span asp-validation-for="DisplayName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Описание</label>
                            <input asp-for="Description" class="form-control" />
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input asp-for="AllowAllAuthenticated" class="form-check-input" id="allowAllCheck" />
                            <label asp-for="AllowAllAuthenticated" class="form-check-label" for="allowAllCheck">
                                <strong>Доступно всем авторизованным</strong>
                            </label>
                            <div class="form-text">Если включено, любой вошедший в систему пользователь может обращаться к этому контроллеру независимо от ролей.</div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4" id="rolesCard">
                    <div class="card-header">
                        <h5 class="mb-0">Разрешённые роли</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @for (int i = 0; i < Model.Roles.Count; i++)
                            {
                                <input type="hidden" asp-for="Roles[i].RoleId" />
                                <input type="hidden" asp-for="Roles[i].RoleName" />
                                <div class="col-md-4">
                                    <div class="form-check mb-2">
                                        <input asp-for="Roles[i].IsSelected" class="form-check-input" />
                                        <label class="form-check-label" for="Roles_@(i)__IsSelected">
                                            <strong>@Model.Roles[i].RoleName</strong>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-check-lg"></i> Сохранить
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-arrow-left"></i> Назад
                    </a>
                </div>
            </form>
        </div>

        <!-- Панель предпросмотра -->
        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-eye"></i> Предпросмотр</h6>
                </div>
                <div class="card-body">
                    <p><strong>Контроллер:</strong> <code>@Model.ControllerName</code></p>
                    <p><strong>Имя:</strong> @Model.DisplayName</p>
                    <p>
                        <strong>Режим:</strong>
                        @if (Model.AllowAllAuthenticated)
                        {
                            <span class="badge bg-success">Все авторизованные</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Ограничено ролями</span>
                        }
                    </p>
                    <p><strong>Разрешённые роли:</strong></p>
                    @if (Model.Roles.Any(r => r.IsSelected))
                    {
                        @foreach (var r in Model.Roles.Where(r => r.IsSelected))
                        {
                            <span class="badge bg-info me-1">@r.RoleName</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">Не выбраны</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('allowAllCheck').addEventListener('change', function () {
            document.getElementById('rolesCard').style.opacity = this.checked ? '0.5' : '1';
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}
